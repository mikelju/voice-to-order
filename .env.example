# Voice-to-Order — environment template. Copy to .env (gitignored) and fill in.
# Demo mode needs NONE of the API keys; it runs fully offline.

APP_MODE=demo                 # demo | real

# Local Postgres (docker-compose maps the container's 5432 to host 5433)
DATABASE_URL=postgresql://vto:vto@localhost:5433/vto

# Real mode only (live models). Leave empty in demo mode.
OPENAI_API_KEY=               # whisper-1 (transcription) + text-embedding-3-small
GOOGLE_API_KEY=               # gemini-2.5-flash (extraction + re-rank)

# Optional chaos switch: substring match on erp,email,history (e.g. SIMULATE_FAILURE=erp)
SIMULATE_FAILURE=

# --- Anonymization tool only (author's machine; NEVER commit real values) ---
# REAL_DATA_DIR=              # path to the real source data (outside the repo)
# ANON_SALT=                  # secret salt for the id HMAC (outside the repo)
# REAL_REPLACEMENTS_FILE=     # term=>token mapping of real names (outside the repo)
